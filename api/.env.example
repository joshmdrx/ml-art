# Copy to .env (gitignored) and fill in values.

DATABASE_URL=postgres://ml_art:dev@localhost:5433/ml_art_dev
PORT=9100

# Optional: enables vector search. Get a free key at https://jina.ai
JINA_API_KEY=

EMBEDDING_MODEL_NAME=jinaai/jina-clip-v2
EMBEDDING_MODEL_VERSION=v2

# Mapbox: forward-geocodes addresses on artist_locations writes (T-038).
# When unset, location rows are created with NULL lat/lng and stay
# hidden from public surfaces — the studio UI shows them as "Locating…".
# Generate a token at https://account.mapbox.com/access-tokens/ (free
# tier: 100k geocoding requests/month + 50k map loads/month).
MAPBOX_TOKEN=

# Resend (T-032): enables real inquiry email delivery. Both keys
# required; when either is absent the jobs-worker handler logs +
# returns Ok without sending. Free tier: 3k emails/mo, 100/day.
# Domain must be verified in the Resend dashboard before the FROM
# address resolves.
RESEND_API_KEY=
RESEND_FROM_EMAIL=inquiries@example.com

# Public-facing web URL — what email links resolve to. Dev:
# http://localhost:3000. Prod: the platform's canonical hostname.
WEB_BASE_URL=http://localhost:3000

# T-008 image moderation. When `REKOGNITION_ENABLED=true` the jobs
# worker would call AWS Rekognition `DetectModerationLabels`; today the
# Real client is not yet wired (deferred until our AWS deploy lands),
# so even with the toggle on the worker still auto-approves (and logs
# a warning). The gating exists so the wire-up is a one-spot change
# later. Leave unset / false in dev.
# REKOGNITION_ENABLED=false

# Anthropic: enables onboarding intake + statement polish.
ANTHROPIC_API_KEY=

# Anonymous-cookie HMAC secret. Required in prod; default is dev-only.
ANON_COOKIE_SECRET=dev-secret-rotate-in-prod

# Clerk JWT verification. Required in prod.
CLERK_ISSUER=
CLERK_JWKS_URL=

# Rate limiting (core::middleware::rate_limit).
# Defaults: /search 60/min, inquiry 3/hr — fine for everyday dev. Flip
# this to `true` if you're hammer-testing the inquiry form repeatedly.
# RATE_LIMIT_DISABLED=false
# RATE_LIMIT_SEARCH_PER_MIN=60
# RATE_LIMIT_INQUIRY_PER_HOUR=3

# S3 / MinIO. The dev compose stack runs MinIO; for prod, omit the
# endpoint URL so the SDK uses real S3 and rely on the standard AWS
# credential chain (IAM role, instance metadata, etc.) instead of
# static keys.
S3_ENDPOINT_URL=http://localhost:9000
S3_UPLOADS_BUCKET=uploads
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=dev
AWS_SECRET_ACCESS_KEY=devpassword
UPLOADS_PUBLIC_URL_PREFIX=http://localhost:9000/uploads
