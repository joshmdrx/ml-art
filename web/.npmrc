verify-deps-before-run=false

# Flat node_modules instead of pnpm's symlinked default.
#
# Why: OpenNext bundles the server function by copying node_modules
# into the Lambda zip. pnpm's symlinked layout means deeply-nested
# imports (e.g. `@swc/helpers/cjs/_interop_require_default.cjs` from
# inside Next's compiled output) resolve to symlinks that don't
# survive the copy. With hoisted, every package is a real directory
# at the top of node_modules and the bundler finds them as expected.
node-linker=hoisted
