# Repo-wide ignores. Per-subdir `.gitignore` files cover language-specific
# artifacts (node_modules, .next, target/, .venv/, .env*).

# macOS / OS cruft
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# Lefthook local state (the binary itself, dev-installed)
lefthook-local.yml

# Per-developer Compose overrides — e.g. host-port shifts to coexist
# with a parallel project's stack. Committed compose lives in
# docker-compose.dev.yml; *.local.yml is intentionally out.
docker-compose.local.yml
docker-compose.*.local.yml

# Misc tmp
*.log
.tmp/

# Belt-and-braces: never commit secrets even if a subdir gitignore missed
.env
.env.local
.env.*.local
