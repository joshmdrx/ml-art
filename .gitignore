# Repo-wide ignores. Per-subdir `.gitignore` files cover language-specific
# artifacts (node_modules, .next, target/, .venv/, .env*).

# macOS / OS cruft
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# Lefthook local state (the binary itself, dev-installed)
lefthook-local.yml

# Per-developer Compose overrides — e.g. host-port shifts to coexist
# with a parallel project's stack. Committed compose lives in
# docker-compose.dev.yml; *.local.yml is intentionally out.
docker-compose.local.yml
docker-compose.*.local.yml

# Misc tmp
*.log
.tmp/

# Terraform — state, working dirs, and the actual tfvars (we commit
# only `terraform.tfvars.example`). Plans + lock files stay out too;
# the lock file is intentionally NOT committed for v1 because the
# scaffold is single-developer — revisit if/when another contributor
# needs reproducible provider versions.
infra/**/.terraform/
infra/**/.terraform.lock.hcl
infra/**/terraform.tfstate
infra/**/terraform.tfstate.*
infra/**/*.tfplan
infra/**/terraform.tfvars
infra/**/*.auto.tfvars

# Belt-and-braces: never commit secrets even if a subdir gitignore missed
.env
.env.local
.env.*.local
